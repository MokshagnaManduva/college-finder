DATABASE_URL=postgresql+asyncpg://college:college@localhost:5432/college_finder
# Required: generate a unique secret with python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
JWT_EXPIRY_DAYS=7
# Enable only for local development to load the explicitly labelled demo fixtures.
ALLOW_DEMO_SEED=false
# Explicit opt-in for an empty, labelled hosted-demo catalog. Never creates a demo login.
BOOTSTRAP_DEMO_CATALOG=false
# make test supplies a separate disposable database; direct pytest needs:
# TEST_DATABASE_URL=postgresql+asyncpg://college:college@localhost:5432/college_finder_test
