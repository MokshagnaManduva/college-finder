# api is the default for the connected application. Set demo for a fixture-only dev preview.
VITE_DATA_MODE=api
# Local development proxies /api to FastAPI on port 8000.
# When deploying separately, use the backend's full public /api URL instead.
VITE_API_URL=/api
# Set true on the free temporary deployment to show the workspace-backup notice.
VITE_TEMPORARY_DEMO=false
